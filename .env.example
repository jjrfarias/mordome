DATABASE_URL="postgresql://mordome:mordome_local@localhost:5432/mordome?schema=public"

# Segurança de contas (SMTP contratado). URL canônica, sem caminho; HTTPS em produção.
# AUTH_PUBLIC_URL=https://seu-dominio.example
# AUTH_RATE_SECRET=<segredo aleatorio com pelo menos 32 caracteres>
# SMTP_HOST=smtp.seu-provedor.example
# SMTP_PORT=587
# SMTP_USER=<usuario smtp>
# SMTP_PASSWORD=<senha smtp>
# SMTP_FROM=acesso@seu-dominio.example
# Porta 587 exige STARTTLS; 465 usa TLS direto. Certificados sempre verificados.

# Libera a vitrine demonstrativa /pedido-online/demonstracao em produção (padrão: desligada).
# STOREFRONT_DEMO_ENABLED=true

# Customer phone login remains hidden until CUSTOMER_AUTH_SECRET is configured and the
# WhatsApp account is paired by an authorized manager.
# CUSTOMER_AUTH_SECRET=<random secret of at least 32 characters>

# TV / Stories: bucket privado S3. No Railway, use referências ao bucket mordome-tv.
# TV_S3_ENDPOINT=${{mordome-tv.ENDPOINT}}
# TV_S3_BUCKET=${{mordome-tv.BUCKET}}
# TV_S3_REGION=${{mordome-tv.REGION}}
# TV_S3_ACCESS_KEY_ID=${{mordome-tv.ACCESS_KEY_ID}}
# TV_S3_SECRET_ACCESS_KEY=${{mordome-tv.SECRET_ACCESS_KEY}}
# TV_S3_FORCE_PATH_STYLE=false
# O token Instagram usa CUSTOMER_AUTH_SECRET, com chave/AAD exclusivas da TV.
# META_GRAPH_VERSION=v25.0
