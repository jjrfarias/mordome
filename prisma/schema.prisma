model AuditEvent {
  id              String         @id @default(cuid())
  organizationId  String
  establishmentId String?
  actorId         String
  action          AuditAction
  entityType      String
  entityId        String
  reason          String?
  before          Json?
  after           Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime       @default(now())
  organization    Organization   @relation(fields: [organizationId], references: [id])
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])
  actor           User           @relation("AuditActor", fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
  @@index([establishmentId, createdAt])
  @@index([entityType, entityId])
  @@index([organizationId, actorId, createdAt])
  @@index([organizationId, action, createdAt])
}

enum FinancialCategoryKind {
  INCOME
  EXPENSE
}

model FinancialCategory {
  id             String                @id @default(cuid())
  organizationId String
  name           String
  kind           FinancialCategoryKind
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries        FinancialEntry[]

  @@unique([organizationId, name, kind])
  @@index([organizationId, active])
}

// Motivos pré-definidos de cancelamento/reembolso (ver ADR 0029). Escopo por organização:
// motivos tendem a ser os mesmos em todas as unidades de uma rede.
enum CancellationReasonCategory {
  SALE_CANCEL
  ITEM_CANCEL
  REFUND
}

model CancellationReason {
  id             String                     @id @default(cuid())
  organizationId String
  category       CancellationReasonCategory
  label          String
  active         Boolean                    @default(true)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, category, label])
  @@index([organizationId, category, active])
}

// Cupons de desconto (ver ADR 0041). Escopo por organização, mesmo padrão de
// `FinancialCategory`/`CancellationReason`: cupons tendem a valer para toda a rede, não para uma
// unidade isolada. `discountValue` é percentual (0-100) quando `discountType = PERCENT`, ou um
// valor fixo em R$ quando `discountType = FIXED`. `validFrom`/`validUntil` nulos significam "sem
// validade" (nunca expira) naquela ponta. `maxUses` nulo significa uso ilimitado. Nunca excluído,
// só inativado (`active = false`), mesmo padrão de todos os cadastros do sistema.
enum CouponDiscountType {
  PERCENT
  FIXED
}

model Coupon {
  id             String             @id @default(cuid())
  organizationId String
  code           String
  discountType   CouponDiscountType
  discountValue  Decimal            @db.Decimal(12, 2)
  validFrom      DateTime?
  validUntil     DateTime?
  maxUses        Int?
  usesCount      Int                @default(0)
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  redemptions    CouponRedemption[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

// Registro de cada uso de cupom em uma venda concluída (ver ADR 0041, decisão sobre relatório
// detalhado). Alimenta o relatório "Cupons gerados" (quantos usos e quanto de desconto no
// período), sem duplicar `Sale.discount`/`Sale.discountReason` — a venda continua registrando o
// desconto normalmente, e este registro só amarra "qual cupom gerou qual parte desse desconto".
model CouponRedemption {
  id              String        @id @default(cuid())
  couponId        String
  saleId          String
  establishmentId String
  discountApplied Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())
  coupon          Coupon        @relation(fields: [couponId], references: [id], onDelete: Cascade)
  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([saleId])
  @@index([couponId, createdAt])
}

model BankAccount {
  id              String           @id @default(cuid())
  establishmentId String
  name            String
  bank            String
  agency          String?
  accountNumber   String?
  initialBalance  Decimal          @default(0) @db.Decimal(12, 2)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  establishment   Establishment    @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  entries         FinancialEntry[]

  @@unique([establishmentId, name])
  @@index([establishmentId, active])
}

model PaymentMethodConfig {
  id              String           @id @default(cuid())
  establishmentId String
  name            String
  kind            String
  feeRate         Decimal?         @db.Decimal(5, 2)
  settlementDays  Int?
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  establishment   Establishment    @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  entries         FinancialEntry[]

  @@unique([establishmentId, name])
  @@index([establishmentId, active])
}

enum FinancialEntryStatus {
  PENDING
  PAID
}

model FinancialEntry {
  id              String               @id @default(cuid())
  organizationId  String
  establishmentId String
  categoryId      String
  bankAccountId   String?
  paymentMethodId String?
  supplierId      String?
  description     String
  amount          Decimal              @db.Decimal(12, 2)
  dueDate         DateTime
  paidAt          DateTime?
  status          FinancialEntryStatus @default(PENDING)
  notes           String?
  reconciled      Boolean              @default(false)
  reconciledAt    DateTime?
  reconciledById  String?
  createdById     String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment   Establishment        @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  category        FinancialCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bankAccount     BankAccount?         @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  paymentMethod   PaymentMethodConfig? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  supplier        Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy       User                 @relation("FinancialEntryCreatedBy", fields: [createdById], references: [id])
  reconciledBy    User?                @relation("FinancialEntryReconciledBy", fields: [reconciledById], references: [id], onDelete: SetNull)

  @@index([establishmentId, status, dueDate])
  @@index([organizationId, status, dueDate])
  @@index([categoryId])
  @@index([supplierId])
  @@index([establishmentId, bankAccountId, status, paidAt])
}

model Supplier {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  tradeName      String?
  document       String?
  phone          String?
  email          String?
  notes          String?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries        FinancialEntry[]
  goodsReceiptNotes GoodsReceiptNote[]
  purchaseOrders    PurchaseOrder[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

// Cadastro de clientes (ADR 0047), escopo organização (não por unidade) — o mesmo cliente é
// reconhecido em qualquer estabelecimento da rede. Identificado por telefone (único por
// organização), preenchido automaticamente ao criar um pedido de delivery com um telefone novo,
// sem exigir cadastro manual prévio.
model Customer {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  phone          String
  email          String?
  document       String?
  notes          String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveryOrders DeliveryOrder[]

  @@unique([organizationId, phone])
  @@index([organizationId, active, name])
}

enum SettlementRole {
  COURIER
  WAITER
}

model UserCommissionRule {
  id                String         @id @default(cuid())
  establishmentId   String
  userId            String
  role              SettlementRole
  amountPerDelivery Decimal?       @db.Decimal(12, 2)
  percentOfSales    Decimal?       @db.Decimal(5, 2)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  establishment     Establishment  @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, userId, role])
  @@index([establishmentId, role])
}

model SettlementRecord {
  id              String         @id @default(cuid())
  establishmentId String
  userId          String
  role            SettlementRole
  from            DateTime
  to              DateTime
  amount          Decimal        @db.Decimal(12, 2)
  paidAt          DateTime       @default(now())
  createdById     String
  establishment   Establishment  @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  user            User           @relation("SettlementUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy       User           @relation("SettlementCreatedBy", fields: [createdById], references: [id])

  @@unique([establishmentId, userId, role, from, to])
  @@index([establishmentId, role, paidAt])
  @@index([userId])
}

// Fundação fiscal (ADR 0049): configuração por estabelecimento para emissão de NFC-e via um
// provedor externo (Focus NFe) — a unidade traz sua PRÓPRIA conta/token do provedor, certificado
// digital e CSC são configurados diretamente no painel do provedor (nunca armazenados aqui) — ver
// ADR para o porquê dessa divisão de responsabilidade.
enum FiscalTaxRegime {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
}

enum FiscalEnvironment {
  HOMOLOGACAO
  PRODUCAO
}

enum FiscalDocumentStatus {
  PENDING
  AUTHORIZED
  REJECTED
  CANCELLED
  ERROR
}

model FiscalConfig {
  id                String            @id @default(cuid())
  establishmentId   String            @unique
  active            Boolean           @default(false)
  provider          String            @default("FOCUS_NFE")
  providerApiToken  String?
  environment       FiscalEnvironment @default(HOMOLOGACAO)
  stateRegistration String?
  taxRegime         FiscalTaxRegime?
  // Opcional por unidade (ver ADR 0049): imprimir o DANFE-NFC-e (com QR code) no lugar do recibo
  // comum quando a nota sair autorizada. Desligado por padrão mesmo com o módulo fiscal ativo —
  // algumas unidades preferem manter o recibo interno de sempre e consultar o DANFE só quando
  // precisar, ao invés de trocar a impressão de todo balcão sem aviso.
  printDanfe        Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  establishment     Establishment     @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
}

model FiscalDocument {
  id              String               @id @default(cuid())
  establishmentId String
  saleId          String               @unique
  status          FiscalDocumentStatus @default(PENDING)
  environment     FiscalEnvironment
  accessKey       String?
  number          String?
  series          String?
  statusMessage   String?
  danfeUrl        String?
  qrCodeUrl       String?
  cancelReason    String?
  cancelledAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  establishment   Establishment        @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  sale            Sale                 @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([establishmentId, status])
}
