generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  SUPPLY
  WITHDRAWAL
}

enum IntegrationCategory {
  PRINTER
  PAYMENT
  SCALE
}

enum SaleChannel {
  POS
  FLOOR
  ONLINE
  DELIVERY
}

enum CatalogChannel {
  POS
  FLOOR
  ONLINE
  DELIVERY
}

enum InventoryUnit {
  GRAM
  MILLILITER
  UNIT
}

enum InventoryTrackingMode {
  AUTOMATIC
  MANUAL
  NONE
}

enum GoodsReceiptStatus {
  DRAFT
  CONFIRMED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  ENTRY
  CONSUMPTION
  LOSS
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  REVERSAL
  PRODUCTION_IN
  PRODUCTION_OUT
}

enum RecipeKind {
  SALE
  PREPARATION
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_REFUNDED
  CANCELLED
  REFUNDED
}

enum DeliveryStatus {
  RECEIVED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum DeliveryOrigin {
  INTERNAL
  ONLINE
}

enum TabStatus {
  OPEN
  PAID
  CANCELLED
}

enum OrderStatus {
  RECEIVED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ESTABLISHMENT_SWITCH
  PERMISSION_CHANGE
  CASH_OPEN
  CASH_CLOSE
  CASH_MOVEMENT
  SALE_COMPLETE
  SALE_CANCEL
  SALE_REFUND
  DISCOUNT_APPLY
  STOCK_ENTRY
  STOCK_CONFIGURE
  STOCK_TRANSFER
  STOCK_ADJUST
  PRINT_REPRINT
  TAB_OPEN
  TAB_ITEM_CHANGE
  TAB_ITEM_CANCEL
  ORDER_SENT
  ORDER_STATUS_CHANGE
  TAB_CLOSE
}

model User {
  id             String                   @id @default(cuid())
  name           String
  username       String                   @unique
  passwordHash   String
  active         Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  memberships    OrganizationMembership[]
  auditEvents    AuditEvent[]             @relation("AuditActor")
  cashSessions   CashSession[]
  cashMovements  CashMovement[]
  sales          Sale[]
  sessions       Session[]
  stockMovements StockMovement[]
  openedTabs     Tab[]                    @relation("TabOpenedBy")
  addedTabItems  TabItem[]                @relation("TabItemAddedBy")
  sentOrders     Order[]                  @relation("OrderSentBy")
  orderStatusChanges OrderStatusHistory[] @relation("OrderStatusChangedBy")
  orderItemCancellations OrderItemCancellation[]
  refunds        Refund[]
  assignedTables DiningTable[]            @relation("TableAssignedWaiter")
  courierDeliveries DeliveryOrder[]       @relation("DeliveryCourier")
  createdDeliveries DeliveryOrder[]       @relation("DeliveryCreatedBy")
  liveLocation      CourierLocation?      @relation("CourierLiveLocation")
  financialEntriesCreated FinancialEntry[] @relation("FinancialEntryCreatedBy")
  financialEntriesReconciled FinancialEntry[] @relation("FinancialEntryReconciledBy")
  commissionRules         UserCommissionRule[]
  settlementRecords       SettlementRecord[]   @relation("SettlementUser")
  settlementsCreated      SettlementRecord[]   @relation("SettlementCreatedBy")
  goodsReceiptNotesCreated GoodsReceiptNote[]
  purchaseOrdersCreated   PurchaseOrder[]
  shoppingListItemsCreated ShoppingListItem[]
}

model Session {
  id                    String         @id @default(cuid())
  userId                String
  activeEstablishmentId String?
  tokenHash             String         @unique
  expiresAt             DateTime
  createdAt             DateTime       @default(now())
  lastSeenAt            DateTime       @default(now())
  ipAddress             String?
  userAgent             String?
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeEstablishment   Establishment? @relation(fields: [activeEstablishmentId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([activeEstablishmentId])
}

model Organization {
  id             String                   @id @default(cuid())
  name           String
  slug           String                   @unique
  active         Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  establishments Establishment[]
  memberships    OrganizationMembership[]
  roles          CustomRole[]
  overrides      UserPermissionOverride[]
  auditEvents    AuditEvent[]
  sales          Sale[]
  categories     Category[]
  products       Product[]
  inventoryItems InventoryItem[]
  recipes        Recipe[]
  financialCategories FinancialCategory[]
  financialEntries    FinancialEntry[]
  suppliers           Supplier[]
  cancellationReasons CancellationReason[]
  coupons             Coupon[]
  customers           Customer[]
}

model Establishment {
  id               String                       @id @default(cuid())
  organizationId   String
  name             String
  slug             String
  document         String?
  phone            String?
  postalCode       String?
  street           String?
  number           String?
  complement       String?
  neighborhood     String?
  city             String?
  state            String?
  timezone         String                       @default("America/Sao_Paulo")
  serviceRate      Decimal                      @default(10) @db.Decimal(5, 2)
  active           Boolean                      @default(true)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  organization     Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accesses         EstablishmentAccess[]
  cashSessions     CashSession[]
  sales            Sale[]
  productOfferings ProductOffering[]
  inventoryItems   EstablishmentInventoryItem[]
  recipes          Recipe[]
  auditEvents      AuditEvent[]
  sessions         Session[]
  diningTables     DiningTable[]
  tabs             Tab[]
  integrations     EstablishmentIntegration[]
  stations         PreparationStation[]
  productStations  ProductStation[]
  deliveryOrders   DeliveryOrder[]
  bankAccounts     BankAccount[]
  paymentMethods   PaymentMethodConfig[]
  financialEntries FinancialEntry[]
  commissionRules  UserCommissionRule[]
  settlementRecords SettlementRecord[]
  goodsReceiptNotes GoodsReceiptNote[]
  purchaseOrders    PurchaseOrder[]
  shoppingListItems ShoppingListItem[]
  deliveryAreas     DeliveryArea[]
  workShifts        WorkShift[]
  printTemplate     PrintTemplate?
  couponRedemptions CouponRedemption[]
  cashFronts        CashFront[]
  fiscalConfig      FiscalConfig?
  fiscalDocuments   FiscalDocument[]

  @@unique([organizationId, slug])
  @@index([organizationId, active])
}

model PrintTemplate {
  id              String        @id @default(cuid())
  establishmentId String        @unique
  headerText      String?
  footerText      String?
  showDocument    Boolean       @default(false)
  paperWidth      Int           @default(80)
  updatedAt       DateTime      @updatedAt
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
}

model EstablishmentIntegration {
  id              String              @id @default(cuid())
  establishmentId String
  category        IntegrationCategory
  driver          String
  config          Json?
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  establishment   Establishment       @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, category])
}

model PreparationStation {
  id              String               @id @default(cuid())
  establishmentId String
  name            String
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  establishment   Establishment        @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  productLinks    ProductStation[]
  integrations    StationIntegration[]

  @@unique([establishmentId, name])
}

model ProductStation {
  id              String             @id @default(cuid())
  establishmentId String
  productId       String
  stationId       String
  createdAt       DateTime           @default(now())
  establishment   Establishment      @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  product         Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  station         PreparationStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, productId])
}

model StationIntegration {
  id         String              @id @default(cuid())
  stationId  String
  category   IntegrationCategory
  driver     String
  config     Json?
  active     Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  station    PreparationStation  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, category])
}

model OrganizationMembership {
  id             String                   @id @default(cuid())
  organizationId String
  userId         String
  status         MembershipStatus         @default(INVITED)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles          MembershipRole[]
  accesses       EstablishmentAccess[]
  overrides      UserPermissionOverride[]
  workShifts     WorkShiftAssignment[]

  @@unique([organizationId, userId])
  @@index([userId, status])
}

model EstablishmentAccess {
  id              String                 @id @default(cuid())
  membershipId    String
  establishmentId String
  createdAt       DateTime               @default(now())
  membership      OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  establishment   Establishment          @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([membershipId, establishmentId])
  @@index([establishmentId])
}

model Permission {
  id          String                   @id @default(cuid())
  key         String                   @unique
  module      String
  description String
  roleLinks   RolePermission[]
  overrides   UserPermissionOverride[]
}

model CustomRole {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  description    String?
  systemTemplate Boolean          @default(false)
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  memberships    MembershipRole[]

  @@unique([organizationId, name])
}

model RolePermission {
  roleId       String
  permissionId String
  role         CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model MembershipRole {
  membershipId String
  roleId       String
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         CustomRole             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
}

model UserPermissionOverride {
  id             String                 @id @default(cuid())
  organizationId String
  membershipId   String
  permissionId   String
  effect         PermissionEffect
  reason         String
  createdAt      DateTime               @default(now())
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permission     Permission             @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([membershipId, permissionId])
  @@index([organizationId])
}

model CashSession {
  id              String            @id @default(cuid())
  establishmentId String
  openedById      String
  cashFrontId     String?
  status          CashSessionStatus @default(OPEN)
  openingAmount   Decimal           @db.Decimal(12, 2)
  closingAmount   Decimal?          @db.Decimal(12, 2)
  expectedClosingAmount Decimal?    @db.Decimal(12, 2)
  differenceAmount Decimal?         @db.Decimal(12, 2)
  closingBreakdown Json?
  openedAt        DateTime          @default(now())
  closedAt        DateTime?
  establishment   Establishment     @relation(fields: [establishmentId], references: [id])
  openedBy        User              @relation(fields: [openedById], references: [id])
  cashFront       CashFront?        @relation(fields: [cashFrontId], references: [id], onDelete: SetNull)
  sales           Sale[]
  movements       CashMovement[]
  refunds         Refund[]

  @@index([establishmentId, status])
  @@index([cashFrontId, status])
}

// Frentes de caixa (ADR 0048): terminais nomeados por estabelecimento (ex.: "Caixa 1", "Caixa
// Delivery"), independentes de quem está logado — hoje cada operador já abre sua própria
// `CashSession` na unidade (permite vários caixas simultâneos), mas sem nome/identidade própria.
// Vínculo opcional: estabelecimentos com uma única frente (ou nenhuma cadastrada) continuam
// abrindo caixa exatamente como antes, sem exigir escolha nenhuma.
model CashFront {
  id              String        @id @default(cuid())
  establishmentId String
  name            String
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  cashSessions    CashSession[]

  @@unique([establishmentId, name])
  @@index([establishmentId, active])
}

model CashMovement {
  id             String           @id @default(cuid())
  cashSessionId  String
  actorId        String
  type           CashMovementType
  amount         Decimal          @db.Decimal(12, 2)
  reason         String
  idempotencyKey String           @unique
  createdAt      DateTime         @default(now())
  cashSession    CashSession      @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  actor          User             @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([cashSessionId, createdAt])
}

model Sale {
  id              String        @id @default(cuid())
  organizationId  String
  establishmentId String
  cashSessionId   String?
  idempotencyKey  String        @unique
  operatorId      String
  channel         SaleChannel
  status          SaleStatus    @default(COMPLETED)
  subtotal        Decimal       @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  serviceAmount   Decimal       @default(0) @db.Decimal(12, 2)
  deliveryFee     Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  completedAt     DateTime      @default(now())
  cancelledAt     DateTime?
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  organization    Organization  @relation(fields: [organizationId], references: [id])
  cashSession     CashSession?  @relation(fields: [cashSessionId], references: [id])
  operator        User          @relation(fields: [operatorId], references: [id])
  items           SaleItem[]
  payments        Payment[]
  refunds         Refund[]
  tab             Tab?
  deliveryOrder   DeliveryOrder?
  couponRedemption CouponRedemption?
  fiscalDocument  FiscalDocument?

  @@index([organizationId, establishmentId, completedAt])
  @@index([cashSessionId, status])
}

model DiningTable {
  id               String        @id @default(cuid())
  establishmentId  String
  number           Int
  seats            Int           @default(4)
  name             String?
  area             String?
  assignedWaiterId String?
  active           Boolean       @default(true)
  isCounter        Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  establishment    Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  assignedWaiter   User?         @relation("TableAssignedWaiter", fields: [assignedWaiterId], references: [id], onDelete: SetNull)
  tabs             Tab[]

  @@unique([establishmentId, number])
  @@index([establishmentId, active, number])
  @@index([establishmentId, area])
}

model DeliveryOrder {
  id              String         @id @default(cuid())
  establishmentId String
  customerName    String
  customerPhone   String
  address         String
  destinationLat  Float?
  destinationLng  Float?
  notes           String?
  status          DeliveryStatus @default(RECEIVED)
  origin          DeliveryOrigin @default(INTERNAL)
  courierId       String?
  deliveryAreaId  String?
  deliveryFee     Decimal?       @db.Decimal(10, 2)
  saleId          String?        @unique
  kitchenOrderId  String?        @unique
  createdById     String?
  customerId      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  establishment   Establishment  @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  courier         User?          @relation("DeliveryCourier", fields: [courierId], references: [id], onDelete: SetNull)
  createdBy       User?          @relation("DeliveryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sale            Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  deliveryArea    DeliveryArea?  @relation(fields: [deliveryAreaId], references: [id], onDelete: SetNull)
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items           DeliveryOrderItem[]

  @@index([establishmentId, status])
  @@index([establishmentId, deliveryAreaId])
  @@index([customerId])
}

// Áreas/zonas de entrega cadastradas por estabelecimento, com taxa fixa e bairros atendidos em
// texto livre (sem geolocalização real — decisão registrada no ADR 0028). Nunca são excluídas,
// apenas inativadas, seguindo o mesmo padrão dos demais cadastros do sistema.
model DeliveryArea {
  id              String         @id @default(cuid())
  establishmentId String
  name            String
  deliveryFee     Decimal        @db.Decimal(10, 2)
  neighborhoods   String?
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  establishment   Establishment  @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  orders          DeliveryOrder[]

  @@unique([establishmentId, name])
  @@index([establishmentId, active])
}

// Turno de trabalho da equipe (escala), ver ADR 0030. Não confundir com CashSession
// (turno de caixa por operador) — este model é sobre horário/escala de trabalho dos
// funcionários, sem qualquer lógica de negócio automática associada ainda.
model WorkShift {
  id              String                @id @default(cuid())
  establishmentId String
  name            String
  startTime       String
  endTime         String
  daysOfWeek      String
  active          Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  establishment   Establishment         @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  assignments     WorkShiftAssignment[]

  @@unique([establishmentId, name])
  @@index([establishmentId, active])
}

model WorkShiftAssignment {
  id           String                 @id @default(cuid())
  workShiftId  String
  membershipId String
  createdAt    DateTime               @default(now())
  workShift    WorkShift              @relation(fields: [workShiftId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([workShiftId, membershipId])
  @@index([membershipId])
}

model CourierLocation {
  courierId String   @id
  lat       Float
  lng       Float
  updatedAt DateTime @updatedAt
  courier   User     @relation("CourierLiveLocation", fields: [courierId], references: [id], onDelete: Cascade)
}

model DeliveryOrderItem {
  id              String        @id @default(cuid())
  deliveryOrderId String
  productId       String?
  productName     String
  quantity        Int
  unitPrice       Decimal       @db.Decimal(12, 2)
  selectedOptionsSnapshot Json?
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
}

model Tab {
  id              String        @id @default(cuid())
  establishmentId String
  tableId         String
  openedById      String
  saleId          String?       @unique
  status          TabStatus     @default(OPEN)
  openedAt        DateTime      @default(now())
  closedAt        DateTime?
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  table           DiningTable   @relation(fields: [tableId], references: [id], onDelete: Restrict)
  openedBy        User          @relation("TabOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  sale            Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  items           TabItem[]
  orders          Order[]

  @@index([establishmentId, status, openedAt])
  @@index([tableId, status])
}

model TabItem {
  id              String         @id @default(cuid())
  tabId           String
  productId       String?
  productName     String
  quantity        Decimal        @db.Decimal(10, 3)
  sentQuantity    Decimal        @default(0) @db.Decimal(10, 3)
  unitPrice       Decimal        @db.Decimal(12, 2)
  active          Boolean        @default(true)
  selectedOptionsSnapshot Json?
  addedById       String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tab             Tab            @relation(fields: [tabId], references: [id], onDelete: Cascade)
  product         Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  addedBy         User           @relation("TabItemAddedBy", fields: [addedById], references: [id], onDelete: Restrict)
  orderItems      OrderItem[]

  @@index([tabId, active])
  @@index([productId])
}

model Order {
  id              String               @id @default(cuid())
  tabId           String
  status          OrderStatus          @default(RECEIVED)
  sentById        String
  sentAt          DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  tab             Tab                  @relation(fields: [tabId], references: [id], onDelete: Restrict)
  sentBy          User                 @relation("OrderSentBy", fields: [sentById], references: [id], onDelete: Restrict)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]

  @@index([tabId, sentAt])
  @@index([status, sentAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  tabItemId   String
  productName String
  quantity    Decimal  @db.Decimal(10, 3)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tabItem     TabItem  @relation(fields: [tabItemId], references: [id], onDelete: Restrict)
  cancellations OrderItemCancellation[]

  @@index([orderId])
}

model OrderItemCancellation {
  id          String    @id @default(cuid())
  orderItemId String
  quantity    Decimal   @db.Decimal(10, 3)
  reason      String
  actorId     String
  createdAt   DateTime  @default(now())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  actor       User      @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([orderItemId, createdAt])
  @@index([actorId, createdAt])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  actorId   String
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor     User        @relation("OrderStatusChangedBy", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  productId   String?
  productName String
  quantity    Decimal  @db.Decimal(10, 3)
  unitPrice   Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  recipeSnapshot Json?
  selectedOptionsSnapshot Json?
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  receivedAmount Decimal? @db.Decimal(12, 2)
  changeAmount Decimal    @default(0) @db.Decimal(12, 2)
  createdAt DateTime      @default(now())
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Refund {
  id             String          @id @default(cuid())
  saleId         String
  cashSessionId  String
  actorId        String
  amount         Decimal         @db.Decimal(12, 2)
  restoreStock   Boolean         @default(false)
  reason         String
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())
  sale           Sale            @relation(fields: [saleId], references: [id], onDelete: Restrict)
  cashSession    CashSession     @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  actor          User            @relation(fields: [actorId], references: [id], onDelete: Restrict)
  payments       RefundPayment[]

  @@index([saleId, createdAt])
  @@index([cashSessionId, createdAt])
}

model RefundPayment {
  id       String        @id @default(cuid())
  refundId String
  method   PaymentMethod
  amount   Decimal       @db.Decimal(12, 2)
  refund   Refund        @relation(fields: [refundId], references: [id], onDelete: Cascade)
}

model Product {
  id             String           @id @default(cuid())
  organizationId String
  categoryId     String?
  name           String
  slug           String
  description    String?
  imageUrl       String?
  active         Boolean          @default(true)
  // Dados fiscais (ADR 0049) — todos opcionais: só passam a ser exigidos de fato no momento da
  // emissão da NFC-e, quando a unidade tem o módulo fiscal ativo (`FiscalConfig.active`).
  ncm            String?
  cfop           String?
  icmsCst        String?
  icmsOrigin     String?
  unitOfMeasure  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]
  saleItems      SaleItem[]
  tabItems       TabItem[]
  stationLinks   ProductStation[]
  ingredientGroups IngredientGroup[]

  @@unique([organizationId, slug])
  @@index([organizationId, active])
  @@index([categoryId])
}

model IngredientGroup {
  id            String             @id @default(cuid())
