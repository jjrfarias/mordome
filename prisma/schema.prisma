  @@index([organizationId, kind, active])
  @@unique([variantId, establishmentId, kind])
  @@index([variantId, establishmentId])
  @@index([outputInventoryItemId])
}

model RecipeComponent {
  id              String        @id @default(cuid())
  recipeId        String
  inventoryItemId String
