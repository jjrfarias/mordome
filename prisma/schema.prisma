model Recipe {
  id                    String            @id @default(cuid())
  organizationId        String
  establishmentId       String?
  variantId             String?
  outputInventoryItemId String?
  kind                  RecipeKind
  name                  String
  yieldQuantity         Decimal           @default(1) @db.Decimal(14, 3)
  active                Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment         Establishment?    @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  variant               ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  outputInventoryItem   InventoryItem?    @relation("RecipeOutputInventoryItem", fields: [outputInventoryItemId], references: [id], onDelete: SetNull)
