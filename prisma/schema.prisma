  order             PurchaseOrder              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryItem     EstablishmentInventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([orderId])
  @@index([inventoryItemId])
}

model ShoppingListItem {
  id              String                     @id @default(cuid())
  establishmentId String
  inventoryItemId String
  desiredQuantity Decimal                    @db.Decimal(14, 3)
  notes           String?
  resolved        Boolean                    @default(false)
  createdById     String
  createdAt       DateTime                   @default(now())
  establishment   Establishment              @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  inventoryItem   EstablishmentInventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  createdBy       User                       @relation(fields: [createdById], references: [id])

  @@index([establishmentId, resolved])
  @@index([inventoryItemId])
