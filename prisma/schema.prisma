  minimumStock    Decimal               @default(0) @db.Decimal(14, 3)
  allowNegative   Boolean               @default(true)
  active          Boolean               @default(true)
  establishment   Establishment         @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  movements       StockMovement[]
  goodsReceiptItems GoodsReceiptItem[]
  purchaseOrderItems PurchaseOrderItem[]
  shoppingListItems ShoppingListItem[]

  @@unique([establishmentId, inventoryItemId])
  @@index([establishmentId, active])
}

model StockMovement {
  id                  String                     @id @default(cuid())
  establishmentItemId String
  type                StockMovementType
  quantity            Decimal                    @db.Decimal(14, 3)
  unitCost            Decimal?                   @db.Decimal(12, 4)
  actorId             String
  sourceType          String?
  sourceId            String?
  reason              String?
  idempotencyKey      String?                    @unique
  createdAt           DateTime                   @default(now())
